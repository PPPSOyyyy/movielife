-
-    const movieList = document.getElementById("homeOttMovieList");
-    const filterButtons = document.querySelectorAll(".ott-filter-btn");
-
-    function loadOttMovies(provider = "") {
-        if (!movieList) {
-            return;
-        }
-
-        movieList.innerHTML =
-            '<div class="ott-home-loading">OTT 영화를 불러오는 중입니다.</div>';
-
-        let url = "/api/ott-movies?page=1";
-
-        if (provider) {
-            url += "&provider=" + encodeURIComponent(provider);
-        }
-
-        fetch(url)
-            .then(response => {
-                if (!response.ok) {
-                    throw new Error("OTT 영화 조회 실패");
-                }
-                return response.json();
-            })
-            .then(movies => {
-                movieList.innerHTML = "";
-
-                if (!movies || movies.length === 0) {
-                    movieList.innerHTML =
-                        '<div class="ott-home-loading">표시할 영화가 없습니다.</div>';
-                    return;
-                }
-
-                movies.slice(0, 5).forEach(movie => {
-                    const card = document.createElement("div");
