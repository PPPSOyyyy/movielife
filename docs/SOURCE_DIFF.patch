-
-    function login() {
-
-
-        const userId =
-            document
-                .getElementById("userId")
-                .value
-                .trim();
-
-
-        const password =
-            document
-                .getElementById("password")
-                .value;
-
-
-        const rememberId =
-            document
-                .getElementById("rememberId")
-                .checked;
-
-
-        hideLoginError();
-
-
-
-        if (
-            userId === "" ||
-            password === ""
-        ) {
-
-            showLoginError(
-                "아이디와 비밀번호를 입력해 주세요."
-            );
-
-            return;
-
-        }
-
-
-
-        fetch(
-            "/api/members/login",
-            {
-
-                method: "POST",
-
-                headers: {
-
-                    "Content-Type":
-                        "application/json"
-
-                },
-
-                body: JSON.stringify({
-
-                    userId: userId,
-
-                    password: password
-
-                })
-
-            }
-        )
-
-
-        .then(async response => {
-
-
-            const message =
-                await response.text();
-
-
-            if (!response.ok) {
-
-                throw new Error(
-                    message
-                );
-
-            }
-
-
-            return message;
-
-        })
-
-
-        .then(() => {
-
-
-            /*
-             * 아이디 저장
-             */
-
-            if (rememberId) {
-
-                localStorage.setItem(
-                    "savedUserId",
-                    userId
-                );
-
-            } else {
-
-                localStorage.removeItem(
-                    "savedUserId"
-                );
-
-            }
-
-
-
-            /*
-             * 로그인 전 페이지 주소 확인
-             */
-
-            const params =
-                new URLSearchParams(
-                    window.location.search
-                );
-
-
-            let returnUrl =
-                params.get(
-                    "returnUrl"
-                );
-
-
-            /*
-             * returnUrl이 없거나
-             * 잘못된 주소라면 홈으로
-             */
-
-            if (
-                !returnUrl
-                || !returnUrl.startsWith("/")
-                || returnUrl.startsWith("//")
-                || returnUrl.startsWith("/login")
-            ) {
-
-                returnUrl =
-                    "/";
-
-            }
-
-
-            /*
-             * 로그인 성공 팝업 없이
-             * 이전 화면으로 이동
-             */
-
-            window.location.href =
-                returnUrl;
-
-        })
-
-
-        .catch(error => {
-
-
-            console.error(
-                "로그인 실패:",
-                error
-            );
-
-
-            showLoginError(
-                "아이디 또는 비밀번호가 올바르지 않습니다. 입력한 정보를 다시 확인해 주세요."
-            );
-
-        });
-
-    }
