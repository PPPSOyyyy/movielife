+  <div class="movie-info"><h3><a th:href="@{/movies/{id}(id=${movie.id})}" th:text="${movie.title}">영화 제목</a></h3><p th:text="${#strings.isEmpty(movie.releaseDate) ? '개봉일 정보 없음' : movie.releaseDate}">개봉일</p></div>
