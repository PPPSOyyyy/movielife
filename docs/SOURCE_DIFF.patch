-<script>
-
-const reviewForm = document.querySelector("form");
-const reviewContent = document.getElementById("content");
-const reviewError = document.getElementById("reviewError");
-const reviewCharCount = document.getElementById("reviewCharCount");
-const ratingSelect = document.getElementById("rating");
-const reviewIdInput = document.getElementById("reviewId");
-
-const reviewId = reviewIdInput.value;
-const editMode = reviewId !== "";
-
-
-/* ==================================================
-   글자 수 표시
-================================================== */
-
-function updateReviewCount() {
-
-    const length =
-        reviewContent.value.length;
-
-    reviewCharCount.textContent =
-        `${length} / 1000`;
-
-    if (length > 1000) {
-
-        reviewError.textContent =
-            "리뷰는 1000자 이하로 작성해주세요.";
-
-    } else {
-
-        reviewError.textContent =
-            "";
-    }
-}
-
-
-reviewContent.addEventListener(
-    "input",
-    updateReviewCount
-);
-
-
-/* ==================================================
-   리뷰 등록 / 수정
-================================================== */
-
-reviewForm.addEventListener(
-    "submit",
-    async function(event) {
-
-        event.preventDefault();
-
-        const content =
-            reviewContent.value;
-
-        const rating =
-            Number(ratingSelect.value);
-
-        reviewError.textContent =
-            "";
-
-
-        if (
-            !Number.isInteger(rating) ||
-            rating < 1 ||
-            rating > 5
-        ) {
-
-            reviewError.textContent =
-                "별점은 1점부터 5점까지 선택해주세요.";
-
-            return;
-        }
-
-
-        if (content.trim() === "") {
-
-            reviewError.textContent =
-                "리뷰 내용을 입력해주세요.";
-
-            reviewContent.focus();
-
-            return;
-        }
-
-
-        if (content.trim().length > 1000) {
-
-            reviewError.textContent =
-                "리뷰는 1000자 이하로 작성해주세요.";
-
-            reviewContent.focus();
-
-            return;
-        }
-
-
-        const formData =
-            new FormData();
-
-        formData.append(
-            "rating",
-            rating
-        );
-
-        formData.append(
-            "content",
-            content.trim()
-        );
-
-
-        if (!editMode) {
-
-            formData.append(
-                "movieId",
-                document.getElementById("movieId").value
-            );
-        }
-
-
-        try {
-
-            const requestUrl =
-                editMode
-                    ? `/api/reviews/${reviewId}`
-                    : "/api/reviews";
-
-            const requestMethod =
-                editMode
-                    ? "PUT"
-                    : "POST";
-
-
-            const response =
-                await fetch(
-                    requestUrl,
-                    {
-                        method: requestMethod,
-                        body: formData
-                    }
-                );
-
-
-            if (response.status === 401) {
-
-                const returnUrl =
-                    window.location.pathname
-                    + window.location.search;
-
-                if (
-                    typeof openLoginRequiredModal
-                    === "function"
-                ) {
-
-                    openLoginRequiredModal(
-                        returnUrl
-                    );
-
-                } else {
-
-                    window.location.href =
-                        "/login?returnUrl="
-                        + encodeURIComponent(
-                            returnUrl
-                        );
-                }
-
-                return;
-            }
-
-
-            if (!response.ok) {
-
-                const message =
-                    await response.text();
-
-                reviewError.textContent =
-                    message;
-
-                return;
-            }
-
-
-            if (editMode) {
-
-                alert(
-                    "리뷰가 수정되었습니다."
-                );
-
-            } else {
-
-                alert(
-                    "리뷰를 작성했습니다."
-                );
-            }
-
-
-            window.location.href =
-                "/my-reviews";
-
-
-        } catch (error) {
-
-            console.error(error);
-
-            reviewError.textContent =
-                editMode
-                    ? "리뷰 수정 중 오류가 발생했습니다. 다시 시도해주세요."
-                    : "리뷰 등록 중 오류가 발생했습니다. 다시 시도해주세요.";
-        }
-    }
-);
-
-
-/* ==================================================
-   최초 글자 수 표시
-================================================== */
-
-updateReviewCount();
-
-</script>
-
