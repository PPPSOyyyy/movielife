-<script>
-
-let myReviews = [];
-
-const reviewList = document.getElementById("reviewList");
-const reviewCount = document.getElementById("reviewCount");
-const reviewSort = document.getElementById("reviewSort");
-
-async function loadMyReviews() {
-    try {
-        const response = await fetch("/api/reviews/my");
-
-        if (response.status === 401) {
-            reviewCount.textContent = "";
-            reviewSort.style.display = "none";
-
-            reviewList.innerHTML = `
-                <div class="empty-state">
-                    <div class="empty-icon">🔒</div>
-                    <h2>로그인이 필요합니다.</h2>
-                    <p>나의 리뷰를 확인하려면 로그인해주세요.</p>
-                    <a
-                        href="/login?returnUrl=%2Fmy-reviews"
-                        class="review-write-button"
-                    >
-                        로그인하기
-                    </a>
-                </div>
-            `;
-            return;
-        }
-
-        if (!response.ok) {
-            throw new Error("리뷰를 불러오지 못했습니다.");
-        }
-
-        myReviews = await response.json();
-        reviewSort.style.display = "block";
-        reviewCount.textContent = `총 ${myReviews.length}개의 리뷰`;
-        renderReviews();
-
-    } catch (error) {
-        console.error(error);
-        reviewCount.textContent = "";
-        reviewList.innerHTML = `
-            <div class="message">
-                리뷰를 불러오는 중 오류가 발생했습니다.
-            </div>
-        `;
-    }
-}
-
-function renderReviews() {
-    if (myReviews.length === 0) {
-        reviewList.innerHTML = `
-            <div class="empty-state">
-                <div class="empty-icon">✏️</div>
-                <h2>작성한 리뷰가 없습니다.</h2>
-                <p>영화를 보고 나만의 이야기를 남겨보세요.</p>
-                <a href="/movies" class="review-write-button">
-                    영화 보러가기
-                </a>
-            </div>
-        `;
-        return;
-    }
-
-    const reviews = [...myReviews];
-
-    switch (reviewSort.value) {
-        case "oldest":
-            reviews.sort((a, b) =>
-                new Date(a.createdAt) - new Date(b.createdAt)
-            );
-            break;
-
-        case "ratingHigh":
-            reviews.sort((a, b) =>
-                Number(b.rating) - Number(a.rating)
-            );
-            break;
-
-        case "ratingLow":
-            reviews.sort((a, b) =>
-                Number(a.rating) - Number(b.rating)
-            );
-            break;
-
-        case "latest":
-        default:
-            reviews.sort((a, b) =>
-                new Date(b.createdAt) - new Date(a.createdAt)
-            );
-            break;
-    }
-
-    reviewList.innerHTML = reviews.map(review => {
-        const rating = Number(review.rating) || 0;
-        const stars =
-            "★".repeat(rating) +
-            "☆".repeat(Math.max(0, 5 - rating));
-
-        const createdDate = formatDate(review.createdAt);
-        const updatedDate = review.updatedAt
-            ? formatDate(review.updatedAt)
-            : null;
-
-        return `
-            <article class="review-card">
-
-                <div class="review-top">
-                    <div class="movie-info">
-                        <div class="movie-icon">🎬</div>
-                        <div>
-                            <div class="movie-title">
-                                ${escapeHtml(review.movieTitle || "영화")}
-                            </div>
-                        </div>
-                    </div>
-
-                    <div class="rating">
-                        ${stars}
-                    </div>
-                </div>
-
-                <div class="review-content">
-                    ${escapeHtml(review.content)}
-                </div>
-
-                <div class="review-bottom">
-                    <div class="review-date">
-                        ${
-                            updatedDate
-                                ? `작성일 ${createdDate} · 수정일 ${updatedDate}`
-                                : `작성일 ${createdDate}`
-                        }
-                    </div>
-
-                    <div class="review-actions">
-                        <button
-                            type="button"
-                            class="review-action"
-                            onclick="editReview(${review.id})"
-                        >
-                            수정
-                        </button>
-
-                        <button
-                            type="button"
-                            class="review-action delete"
-                            onclick="deleteReview(${review.id})"
-                        >
-                            삭제
-                        </button>
-                    </div>
-                </div>
-
-            </article>
-        `;
-    }).join("");
-}
-
-function editReview(reviewId) {
-    const review = myReviews.find(
-        review => review.id === reviewId
-    );
-
-    if (!review) {
-        alert("리뷰를 찾을 수 없습니다.");
-        return;
-    }
-
-    // 팝업으로 수정하지 않고
-    // 기존 리뷰 작성 화면으로 이동해서 수정합니다.
-    window.location.href =
-        `/review?reviewId=${reviewId}`;
-}
-
-async function deleteReview(reviewId) {
-    const confirmed = confirm(
-        "정말 이 리뷰를 삭제하시겠습니까?"
-    );
-
-    if (!confirmed) {
-        return;
-    }
-
-    try {
-        const response = await fetch(
-            `/api/reviews/${reviewId}`,
-            { method: "DELETE" }
-        );
-
-        const message = await response.text();
-
-        if (!response.ok) {
-            alert(message);
-            return;
-        }
-
-        await loadMyReviews();
-
-    } catch (error) {
-        console.error(error);
-        alert("리뷰 삭제 중 오류가 발생했습니다.");
-    }
-}
-
-function formatDate(value) {
-    if (!value) {
-        return "";
-    }
-
-    return new Date(value).toLocaleDateString("ko-KR");
-}
-
-function escapeHtml(text) {
-    if (text == null) {
-        return "";
-    }
-
-    return String(text)
-        .replace(/&/g, "&amp;")
-        .replace(/</g, "&lt;")
-        .replace(/>/g, "&gt;")
-        .replace(/"/g, "&quot;")
-        .replace(/'/g, "&#039;");
-}
-
-reviewSort.addEventListener("change", renderReviews);
-
-loadMyReviews();
-
-</script>
-
