+    <a th:href="@{/movies/{id}(id=${movie.id})}" th:aria-label="${movie.title} + ' 상세 보기'"><img th:src="${movie.posterUrl}" th:alt="${movie.title} + ' 포스터'" loading="lazy" width="240" height="360" data-poster></a>
+    <span class="rating-badge">★ <span th:text="${movie.voteAverage != null ? #numbers.formatDecimal(movie.voteAverage, 1, 1) : '—'}">—</span></span>
+    <button type="button" class="favorite-toggle" th:data-favorite="${movie.id}" th:data-title="${movie.title}" aria-label="찜하기" aria-pressed="false">♡</button>
