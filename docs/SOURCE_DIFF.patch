-<script th:inline="javascript">
-
-    /*
-
-     * MY MOVIE는 사용자의 찜 영화이므로 고정합니다.
-
-     * BEST MOVIE는 평점이 가장 높은 영화로 고정합니다.
-
-     * TODAY'S PICK만 30초마다 변경합니다.
-
-     */
-
-    const rotatingHeroMovies = [
-
-        /*[# th:each="movie : ${heroMovies}"]*/
-
-        {
-
-            id: /*[[${movie.id}]]*/ 0,
-
-            posterUrl: /*[[${movie.posterUrl}]]*/ "",
-
-            title: /*[[${movie.title}]]*/ ""
-
-        },
-
-        /*[/]*/
-
-    ];
-
-    let heroIndex = 1;
-
-    function changeHeroMovies() {
-
-        if (!rotatingHeroMovies || rotatingHeroMovies.length === 0) {
-
-            return;
-
-        }
-
-        const todayMovie =
-
-            rotatingHeroMovies[heroIndex % rotatingHeroMovies.length];
-
-        updateHeroCard(3, todayMovie);
-
-        heroIndex = (heroIndex + 1) % rotatingHeroMovies.length;
-
-    }
-
-    function updateHeroCard(number, movie) {
-
-        if (!movie) {
-
-            return;
-
-        }
-
-        const poster = document.getElementById('heroPoster' + number);
-
-        const link = document.getElementById('heroLink' + number);
-
-        if (poster) {
-
-            poster.src = movie.posterUrl || '/poster/no-poster.png';
-
-            poster.alt = movie.title || '영화 포스터';
-
-        }
-
-        if (link && movie.id) {
-
-            link.href = '/movies/' + movie.id;
-
-        }
-
-    }
-
-    setInterval(changeHeroMovies, 30000);
-
-</script>
